{
    "$schema": "https://schema.native-sdk.dev/app/v1.json",
    "id": "dev.native_sdk.desktop",
    "name": "desktop",
    "display_name": "Desktop",
    "description": "Multi-window desktop integration: model-declared secondary windows, window verbs, and close policies.",
    "version": "0.1.0",
    "icons": ["assets/icon.png"],
    "platforms": ["macos", "linux"],
    "permissions": ["view", "command", "window"],
    "capabilities": ["native_views", "gpu_surfaces"],
    "shell": {
        "windows": [
            {
                "label": "main",
                "title": "Desktop",
                "width": 900,
                "height": 640,
                "titlebar": "hidden_inset",
                "views": [
                    { "label": "main-canvas", "kind": "gpu_surface", "fill": true, "role": "Desktop canvas", "accessibility_label": "Desktop", "gpu_backend": "metal", "gpu_pixel_format": "bgra8_unorm", "gpu_present_mode": "timer", "gpu_alpha_mode": "opaque", "gpu_color_space": "srgb", "gpu_vsync": true }
                ]
            }
        ]
    },
    "security": {
        "navigation": {
            "allowed_origins": ["zero://app", "zero://inline"],
            "external_links": { "action": "deny" }
        }
    },
    "web_engine": "system",
    "cef": { "dir": "third_party/cef/macos", "auto_install": false }
}
