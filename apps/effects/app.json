{
    "$schema": "https://schema.native-sdk.dev/app/v1.json",
    "id": "dev.native_sdk.effects",
    "name": "effects",
    "display_name": "Effects",
    "description": "Subprocesses, HTTP, files, clipboard, and notifications over the effects channel.",
    "version": "0.1.0",
    "icons": ["assets/icon.png"],
    "platforms": ["macos", "linux"],
    "permissions": ["view", "command", "network", "clipboard", "notifications"],
    "capabilities": ["native_views", "gpu_surfaces"],
    "shell": {
        "windows": [
            {
                "label": "main",
                "title": "Effects",
                "width": 760,
                "height": 780,
                "views": [
                    { "label": "main-canvas", "kind": "gpu_surface", "fill": true, "role": "Effects canvas", "accessibility_label": "Effects", "gpu_backend": "metal", "gpu_pixel_format": "bgra8_unorm", "gpu_present_mode": "timer", "gpu_alpha_mode": "opaque", "gpu_color_space": "srgb", "gpu_vsync": true }
                ]
            }
        ]
    },
    "security": {
        "navigation": {
            "allowed_origins": ["zero://app", "zero://inline"],
            "external_links": { "action": "deny" }
        }
    },
    "web_engine": "system",
    "cef": { "dir": "third_party/cef/macos", "auto_install": false }
}
