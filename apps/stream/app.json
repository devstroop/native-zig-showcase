{
    "$schema": "https://schema.native-sdk.dev/app/v1.json",
    "id": "dev.native_sdk.stream",
    "name": "stream",
    "display_name": "Stream",
    "description": "A 100,000-event telemetry feed through one windowed virtual list: only the visible slice is ever built.",
    "version": "0.1.0",
    "icons": ["assets/icon.png"],
    "platforms": ["macos", "linux"],
    "permissions": ["view", "command"],
    "capabilities": ["native_views", "gpu_surfaces"],
    "shell": {
        "windows": [
            {
                "label": "main",
                "title": "Stream",
                "width": 980,
                "height": 720,
                "views": [
                    { "label": "main-canvas", "kind": "gpu_surface", "fill": true, "role": "Event stream canvas", "accessibility_label": "Event stream", "gpu_backend": "metal", "gpu_pixel_format": "bgra8_unorm", "gpu_present_mode": "timer", "gpu_alpha_mode": "opaque", "gpu_color_space": "srgb", "gpu_vsync": true }
                ]
            }
        ]
    },
    "security": {
        "navigation": {
            "allowed_origins": ["zero://app", "zero://inline"],
            "external_links": { "action": "deny" }
        }
    },
    "web_engine": "system",
    "cef": { "dir": "third_party/cef/macos", "auto_install": false }
}
